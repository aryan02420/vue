{
  "name": "@aryan02420/vue-context",
  "version": "0.0.0",
  "description": "A wrapper around Vue's `provide`/`inject`, inspired by React's Context API.",
  "author": {
    "name": "aryan02420"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryan02420/vue.git",
    "directory": "packages/vue-context"
  },
  "homepage": "https://vue.02420.dev/vue-context",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/aryan02420"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/examples",
    "!*.test.ts"
  ],
  "types": "./src/main.ts",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}

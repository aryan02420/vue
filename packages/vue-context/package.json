{
  "name": "@aryan02420/vue-context",
  "version": "0.0.0",
  "description": "A wrapper around Vue's `provide`/`inject`, inspired by React's Context API.",
  "author": {
    "name": "aryan02420"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryan02420/vue.git",
    "directory": "packages/vue-context"
  },
  "homepage": "https://vue.02420.dev/vue-context",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/aryan02420"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/examples",
    "!*.test.ts"
  ],
  "types": "./src/main.ts",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "exports": {
    ".": {
      "development": "./src/main.ts",
      "types": "./src/main.ts",
      "default": "./dist/main.js"
    },
    "./util": {
      "development": "./src/util.ts",
      "types": "./src/util.ts",
      "default": "./dist/util.js"
    },
    "./composable": {
      "development": "./src/composable.ts",
      "types": "./src/composable.ts",
      "default": "./dist/composable.js"
    },
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "test": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
